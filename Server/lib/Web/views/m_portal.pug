extends m_layout

block Subject
	title= locals.lang === 'en_US' ? 'kkutugameskorea' : '끄투게임즈코리아'

block CSS
	link(rel='stylesheet', href='/css/in_portal.css?v=20260927-welcome-2')
	link(rel='stylesheet', href='/css/server-select.css?v=20260917-motion-1')

block JS
	script(src='/js/site-switch.js?v=20260922-play-route-1', defer)

block Middle
	- var IS_EN = locals.lang === 'en_US';
	- var MAINTENANCE = !!locals.MAINTENANCE && !locals.ADMIN;
	- var UNAVAILABLE = !!locals.ACCESS_BLOCKED;
	- var MAINTENANCE_SERVERS = locals.MAINTENANCE_SERVERS || [false, false];
	- var PLAY_DISABLED = MAINTENANCE || UNAVAILABLE;
	- var PLAY_LABEL = UNAVAILABLE ? (IS_EN ? 'Unavailable' : '사용불가 계정') : (MAINTENANCE ? (IS_EN ? 'Maintenance' : '점검중') : (IS_EN ? 'Play' : '게임 시작'));
	- var ENTRY_NAME = SESSION.profile ? (SESSION.profile.title || SESSION.profile.name || (IS_EN ? 'Guest' : '비회원')) : (IS_EN ? 'Guest' : '비회원');
	- var ENTRY_GUEST = !SESSION.profile;
	main.portal-home.mobile-portal
		header.portal-nav
			a.portal-brand(href='/')
				img(src=IS_EN ? '/img/custom/site-logo-en.png?v=20260920b' : '/img/custom/site-logo-ko.png?v=20260920', alt=IS_EN ? 'kkutugameskorea' : '끄투게임즈코리아')
			nav
				a(href='/event')= IS_EN ? 'Event' : '추석 이벤트'
				a(href='https://naver.me/5ulax0y9', target='_blank', rel='noopener noreferrer')= IS_EN ? 'Naver Cafe' : '네이버 카페'
				a(href='https://www.youtube.com/@kkutugame', target='_blank', rel='noopener noreferrer')= IS_EN ? 'YouTube' : '유튜브'
			div.portal-account
				button#language-switch.portal-language(type='button', aria-label=IS_EN ? 'Choose language' : '언어 선택', title=IS_EN ? 'Choose language' : '언어 선택') 文
				if SESSION.profile
					button#portal-logout.portal-login(type='button', onclick="location.href='/logout'")= IS_EN ? 'Logout' : '로그아웃'
				else
					a.portal-login(href='/login?account=login')= IS_EN ? 'Login' : '로그인'
		div#ServerSelectOverlay(hidden, role='dialog', aria-modal='true', aria-labelledby='ServerSelectTitle')
			section.server-select-card
				button#ServerSelectClose.server-select-close(type='button', aria-label='닫기') ×
				header.server-select-head
					img(src=IS_EN ? '/img/custom/site-logo-en.png?v=20260920b' : '/img/custom/site-logo-ko.png?v=20260920', alt=IS_EN ? 'kkutugameskorea' : '끄투게임즈코리아')
					div.server-select-heading
						span= IS_EN ? 'Choose a server' : '함께 놀 서버'
						h2#ServerSelectTitle= IS_EN ? 'Game Servers' : '게임 서버 고르기'
				div#ServerSelectList.server-select-list
					- var chooserList = locals.SERVER_LIST || [0, 0];
					- var chooserLimits = locals.SERVER_LIMITS || [100, 100];
					for chooserCount, chooserIndex in chooserList
						- var chooserLimit = chooserLimits[chooserIndex] || chooserLimits[0] || 100;
						article.server-choice(data-server=chooserIndex, data-maintenance=MAINTENANCE_SERVERS[chooserIndex] ? 'true' : 'false', style='--server-load: '+Math.min(100, chooserCount / chooserLimit * 100)+'%')
							div.server-choice-copy
								div.server-choice-name= chooserIndex === 0 ? (IS_EN ? 'Tree' : '나무') : (chooserIndex === 1 ? (IS_EN ? 'Glass' : '유리') : (IS_EN ? 'Developer' : '개발자 서버'))
								div.server-choice-count= chooserCount + ' / ' + chooserLimit + (IS_EN ? ' online' : '명 접속 중')
							span.server-choice-state= MAINTENANCE_SERVERS[chooserIndex] ? (IS_EN ? 'Maintenance' : '점검중') : (chooserCount / chooserLimit >= .75 ? (IS_EN ? 'Busy' : '보통') : (IS_EN ? 'Good' : '쾌적'))
							button(type='button', disabled=MAINTENANCE_SERVERS[chooserIndex])= MAINTENANCE_SERVERS[chooserIndex] ? (IS_EN ? 'Maintenance' : '점검중') : (IS_EN ? 'Enter' : '입장')
		section.portal-hero#play
			div.portal-slides
				section.portal-entry-card(data-guest=ENTRY_GUEST ? 'true' : 'false', style='--entry-progress:'+(ENTRY_GUEST ? '100%' : '0%'))
					div.portal-entry-welcome
						img(src='/img/custom/server-select-logo.png?v=20260922', alt='끄투게임즈코리아')
						span
							strong= ENTRY_NAME
							= IS_EN ? ', welcome!' : '님 환영합니다.'
					div.portal-entry-main
						div.portal-entry-profile
							b= ENTRY_NAME
							div.portal-entry-level
								span#portal-entry-level= ENTRY_GUEST ? 'Lv.∞' : 'Lv. 불러오는 중'
						button.portal-main-start.maintenance-button(type='button', disabled=PLAY_DISABLED, onclick="document.getElementById('ServerSelectOverlay').hidden=false;")= PLAY_LABEL
		section.portal-content
			section.portal-notice#notice
				div.notice-heading
					h2= IS_EN ? 'Notices' : '공지사항'
					span= IS_EN ? 'Latest KKuTuGame news' : '끄투게임즈코리아의 새로운 소식'
				a.portal-featured-notice#portal-latest-notice(href='/notices.html')
					span= IS_EN ? 'Loading the latest notice.' : '최신 공지를 불러오는 중입니다.'
			aside.portal-side#servers
				div.server-list-box
					h3.server-list-title
						img(src='/img/custom/server-select-logo.png?v=20260922', alt='끄투게임즈코리아')
						span= IS_EN ? 'Server list' : '서버 목록'
						span#server-total
						a#server-refresh(title='새로고침')
							+FA('refresh')
					div#server-list
						//- Render the known servers on the first mobile paint. The
						//- browser then replaces these counts with the live /servers response.
						- var serverList = locals.SERVER_LIST || [0, 0];
						- var serverLimits = locals.SERVER_LIMITS || [100, 100];
						for count, index in serverList
							- var limit = serverLimits[index] || serverLimits[0] || 100;
							- var load = Math.min(100, Math.max(0, Number(count || 0) / limit * 100));
							div.server(id='server-'+index, class=MAINTENANCE_SERVERS[index] ? 'is-maintenance' : (load >= 75 ? 'is-high' : (load >= 50 ? 'is-medium' : 'is-normal')), data-server=index, data-maintenance=MAINTENANCE_SERVERS[index] ? 'true' : 'false')
								div.server-status(class=MAINTENANCE_SERVERS[index] ? 'ss-x' : 'ss-o')
								div.server-name= index === 0 ? (IS_EN ? 'Tree' : '나무') : (index === 1 ? (IS_EN ? 'Glass' : '유리') : (IS_EN ? 'Developer' : '개발자 서버'))
								div.server-people.graph
									div.graph-bar(style='width: '+(MAINTENANCE_SERVERS[index] ? 100 : load)+'%')
									label= MAINTENANCE_SERVERS[index] ? (IS_EN ? 'Maintenance' : '점검중') : (count + ' / ' + limit)
								div.server-enter= MAINTENANCE_SERVERS[index] ? (IS_EN ? 'Maintenance' : '점검중') : (IS_EN ? 'Enter' : '접속')
				div.site-ad-slot.portal-ad-slot(data-ad-placement='portal', aria-label=IS_EN ? 'Advertisement' : '광고')
				div.portal-link-grid
					a(href='https://discord.gg/exfaWJDjU', target='_blank', rel='noopener noreferrer')
						strong= IS_EN ? 'Official Discord' : '공식 디스코드'
						span= IS_EN ? 'Join the community' : '함께 이야기해요'

block Bottom
	div.bottom-legal!= L('dictionarySupport')
	div.bottom-legal!= L('etcSupport')
