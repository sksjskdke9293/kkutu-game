doctype html
html(lang='ko')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='robots', content='noindex')
    title 404 · 페이지를 찾을 수 없어요 | 끄투게임즈코리아
    link(rel='icon', type='image/x-icon', href='/favicon.ico?v=20260913-1')
    style.
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: #d87932; }
      body { min-height: 100vh; min-height: 100dvh; display: grid; place-items: center; isolation: isolate; }
      body::before { content: ''; position: fixed; inset: 0; z-index: -1; background: linear-gradient(#6f38152b, #6f38152b), url('/img/custom/error-404-autumn-v3.png') center / cover no-repeat; filter: blur(20px); }
      main { width: 100%; display: grid; place-items: center; }
      .error-art { display: block; width: 100%; height: 100vh; height: 100dvh; object-fit: contain; object-position: center; }
      .screen-reader { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  body
    main
      h1.screen-reader Error Code: 404
      p.screen-reader 이 페이지는 존재하지 않거나 접속할 수 없는 페이지 같아요.
      img.error-art(src='/img/custom/error-404-autumn-v3.png', alt='가을 풍경과 캐릭터가 있는 끄투게임즈코리아 404 안내', width='1093', height='495')
