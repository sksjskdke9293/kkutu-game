doctype html
html(lang='ko')
  head

    link(rel='icon', type='image/x-icon', href='/favicon.ico?v=20260913-1')
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, viewport-fit=cover')
    meta(name='robots', content='noindex')
    title 끄투게임 점검 중
    script.
      (function(){try{var server=(new URLSearchParams(location.search)).get('server'),x=new XMLHttpRequest();x.open('GET','/api/theme'+(server!==null?'?server='+encodeURIComponent(server):''),false);x.send(null);document.documentElement.setAttribute('data-site-theme',JSON.parse(x.responseText||'{}').theme==='chuseok'?'chuseok':'autumn');}catch(_){document.documentElement.setAttribute('data-site-theme','autumn');}})();
    style.
      * { box-sizing:border-box; }
      html, body { width:100%; min-height:100%; margin:0; }
      body { min-height:100dvh; overflow:hidden; display:grid; place-items:center; padding:28px; color:#0b0b0b; font-family:Arial, 'Noto Sans KR', sans-serif; background:#d85f25 center / cover no-repeat url('/img/custom/intro-desktop.png?v=20260913-intro-2'); }
      html[data-site-theme='chuseok'] body { background-image:url('/img/custom/chuseok-intro-desktop.png?v=20260914-1'); }
      .maintenance-panel { width:min(830px, 88vw); padding:42px 58px 34px; text-align:center; border:1px solid rgba(255,255,255,.46); border-radius:28px; background:rgba(248,250,255,.58); box-shadow:0 18px 55px rgba(65,32,10,.30); backdrop-filter:blur(8px); }
      h1 { margin:0 0 31px; color:#b5761c; font-size:68px; line-height:1; letter-spacing:-7px; text-shadow:0 2px 0 #5d3911, 0 3px 10px rgba(255,255,255,.75); }
      p { margin:0; font-weight:900; font-size:57px; line-height:1.28; letter-spacing:-5px; word-break:keep-all; }
      #redirect-note { margin-top:27px; color:#4b321d; font-size:18px; font-weight:700; letter-spacing:-1px; }
      @media(max-width:767px) { body { padding:20px; background-image:url('/img/custom/intro-mobile.png?v=20260913-intro-1'); } .maintenance-panel { width:min(94vw, 540px); padding:31px 20px 26px; border-radius:22px; } h1 { margin-bottom:24px; font-size:48px; letter-spacing:-5px; } p { font-size:37px; letter-spacing:-3px; } #redirect-note { font-size:15px; } }
      @media(max-width:767px) { html[data-site-theme='chuseok'] body { background-image:url('/img/custom/chuseok-intro-mobile.png?v=20260914-1'); } }
  body
    main.maintenance-panel(role='alert', aria-live='assertive')
      h1 점검
      p 현재는 점검 중이오니<br>접속하실 수 없습니다.
      div#redirect-note 5초 뒤에 메인으로 이동합니다.
    script.
      (function(){
        var remaining=5, note=document.getElementById('redirect-note');
        var timer=setInterval(function(){ remaining--; if(remaining<=0){ clearInterval(timer); location.replace('/'); return; } note.textContent=remaining+'초 뒤에 메인으로 이동합니다.'; },1000);
      })();
