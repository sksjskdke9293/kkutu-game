include module

- if(LANG == undefined) LANG = locals.locale;

doctype html
html
	head
		block Subject
		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0,maximum-scale=1.0, user-scalable=no')
		link(rel='icon', type='image/x-icon', href='/favicon.ico?v=20260913-1')
		link(rel='shortcut icon', href='/favicon.ico?v=20260913-1')
		link(rel='apple-touch-icon', href='/img/custom/site-favicon.png?v=20260912')
		meta(name='application-name', content='끄투게임')
		if locals.canonical
			link(rel='canonical', href=locals.canonical)
		script(type='text/javascript').
			function getObject(v, i) {
				Object.defineProperty(v, i, {value: v[i], writable: false});
			}
			getObject(window.WebSocket, "send");
			getObject(window.WebSocket, "onmessage");
			getObject(window, "WebSocket");

		block Search
			meta(name='description', content=LANG['meta_desc'] || L('META_DESC'))
			meta(name='keywords', content=LANG['meta_keys'] || L('META_KEYS'))

		block OpenGraph
			meta(property='og:image', content=locals.ogImage || 'https://kkutugame.kro.kr/img/custom/site-logo.png?v=20260912')
			meta(property='og:url', content=locals.ogURL || 'https://kkutugame.kro.kr/')
			meta(property='og:title', content=locals.ogTitle || '끄투게임')
			meta(property='og:description', content=locals.ogDescription || '친구들과 함께하는 온라인 끝말잇기')
			meta(property='og:site_name', content='끄투게임')
			meta(property='og:type', content='website')
			meta(name='twitter:card', content='summary_large_image')
			meta(name='twitter:title', content=locals.ogTitle || '끄투게임')
			meta(name='twitter:image', content=locals.ogImage || 'https://kkutugame.kro.kr/img/custom/site-logo.png?v=20260912')
		script(type='application/ld+json').
			{"@context":"https://schema.org","@type":"WebSite","name":"끄투게임","alternateName":"끄투게임","url":"https://kkutugame.kro.kr/"}
		script(type='text/javascript').
			try{var themeRequest=new XMLHttpRequest();var themeServer=(new URLSearchParams(location.search)).get('server');themeRequest.open('GET','/api/theme'+(themeServer!==null?'?server='+encodeURIComponent(themeServer):''),false);themeRequest.send(null);var initialTheme=JSON.parse(themeRequest.responseText||'{}').theme;document.documentElement.setAttribute('data-site-theme',initialTheme==='chuseok'?'chuseok':'autumn');}catch(themeError){document.documentElement.setAttribute('data-site-theme','autumn');}

		+PageHead()
			block Preload
		block CSS
		block JS
		link(rel='stylesheet', href='/css/account-ui.css?v=20260914-user-badge-3')
		link(rel='stylesheet', href='/css/site-theme.css?v=20260914-2')
		script(src='/js/account-ui.js?v=20260912-social-link-3', defer)
		script(src='/js/site-theme.js?v=20260915-server-theme-1', defer)
	script(src='/js/site-notices.js?v=20260913-direct-notice-1', defer)

	body(style='min-width: 200px;')
		div#Top
			+MMenu()
			div#global-notice
				div#gn-content
					include ../public/global_notice.html
			block Top
		div#Jungle
			span#mobile= locals.mobile
			span#summonerID= DATA._id
			img#Background(src='/img/bg/' + (locals.m_bg || 'def.png'))
			block Jungle
		div#Middle
			block Middle
		div#Bottom
			block Bottom
			div.bottom-legal
				a(href='?pc=true')= L('AS_PC')
				br
				a.bottom-contact(href='https://discord.gg/exfaWJDjU', target='_blank', rel='noopener noreferrer') 문의: 디스코드 서버
			div.bottom-legal!= L('GPL')
			+separator(40)
