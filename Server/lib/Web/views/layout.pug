include module

- if(LANG == undefined) LANG = locals.locale;

doctype html
html(lang=locals.lang === 'en_US' ? 'en' : (locals.lang === 'zh_CN' ? 'zh-CN' : 'ko'))
	head
		block Subject
		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no')
		link(rel='icon', type='image/x-icon', href='/favicon.ico?v=20260913-1')
		link(rel='shortcut icon', href='/favicon.ico?v=20260913-1')
		link(rel='apple-touch-icon', href='/img/custom/site-favicon.png?v=20260912')
		script(async, src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6810329915661089', crossorigin='anonymous')
		meta(name='application-name', content=locals.lang === 'en_US' ? 'kkutugameskorea' : '끄투게임즈코리아')
		if locals.canonical
			link(rel='canonical', href=locals.canonical)
			script(type='text/javascript').
				function getObject(v, i) {
					Object.defineProperty(v, i, {value: v[i], writable: false});
				}
				if (typeof window.setInterval !== "function") {
					(function(){
						var sequence = 1, intervals = {};
						var compatSetInterval = function(callback, delay){
							var args = Array.prototype.slice.call(arguments, 2), id = sequence++;
							function tick(){
								if(!intervals[id]) return;
								try { callback.apply(window, args); }
								finally { if(intervals[id]) intervals[id].timer = window.setTimeout(tick, Math.max(0, Number(delay) || 0)); }
							}
							intervals[id] = {timer: window.setTimeout(tick, Math.max(0, Number(delay) || 0))};
							return id;
						};
						var compatClearInterval = function(id){ if(intervals[id]){ window.clearTimeout(intervals[id].timer); delete intervals[id]; } };
					Object.defineProperty(window, 'setInterval', {value: compatSetInterval, writable: false, configurable: false});
					Object.defineProperty(window, 'clearInterval', {value: compatClearInterval, writable: false, configurable: false});
					})();
				}
				getObject(window, "setInterval");
				getObject(window, "clearInterval");
				getObject(window, "setTimeout");
				getObject(window, "clearTimeout");
				getObject(window.WebSocket, "send");
				getObject(window.WebSocket, "onmessage");
				getObject(window, "WebSocket");

		block Search
			meta(name='description', content=LANG['meta_desc'] || L('META_DESC'))
			meta(name='keywords', content=LANG['meta_keys'] || L('META_KEYS'))

		block OpenGraph
			meta(property='og:image', content=locals.ogImage || "https://kkutugame.kr/img/custom/social-preview.png?v=20260922")
			meta(property='og:url', content=locals.ogURL || "http://JJo.kr/")
			meta(property='og:title', content=locals.ogTitle || "쪼롤 - League of Legends 정보 검색 사이트")
			meta(property='og:description', content=locals.ogDescription || '끄투게임즈코리아에서 신나는 끝말잇기 배틀로 승부를 가려보세요!')
			meta(property='og:site_name', content=locals.lang === 'en_US' ? 'kkutugameskorea' : '끄투게임즈코리아')
			meta(property='og:type', content='website')
			meta(name='twitter:card', content='summary_large_image')
			meta(name='twitter:title', content=locals.ogTitle || (locals.lang === 'en_US' ? 'kkutugameskorea' : '끄투게임즈코리아'))
			meta(name='twitter:description', content=locals.ogDescription || '끄투게임즈코리아에서 신나는 끝말잇기 배틀로 승부를 가려보세요!')
			meta(name='twitter:image', content=locals.ogImage || 'https://kkutugame.kr/img/custom/social-preview.png?v=20260922')
		script(type='application/ld+json').
			{"@context":"https://schema.org","@type":"WebSite","name":"끄투게임즈코리아","alternateName":"kkutugameskorea","url":"https://kkutugame.kr/"}
		script(type='text/javascript').
			try{var themeRequest=new XMLHttpRequest();var themeServer=(new URLSearchParams(location.search)).get('server');if(themeServer===null){var playMatch=location.pathname.match(/^\/play([1-3])$/);if(playMatch)themeServer=String(Number(playMatch[1])-1);}themeRequest.open('GET','/api/theme'+(themeServer!==null?'?server='+encodeURIComponent(themeServer):''),false);themeRequest.send(null);var initialTheme=JSON.parse(themeRequest.responseText||'{}').theme;document.documentElement.setAttribute('data-site-theme',initialTheme==='chuseok'?'chuseok':'autumn');}catch(themeError){document.documentElement.setAttribute('data-site-theme','autumn');}

		+PageHead()
			block Preload
		block CSS
		block JS
		link(rel='stylesheet', href='/css/account-ui.css?v=20260927-consent-visible-1')
	link(rel='stylesheet', href='/css/site-theme.css?v=20260914-2')
	link(rel='stylesheet', href='/css/site-ads.css?v=20260926-5')
	script(src='/js/account-ui.js?v=20260927-consent-visible-1', defer)
	script(src='/js/guest-privacy.js?v=20260926-1', defer)
	script(src='/js/playtime-reminder.js?v=20260927-5', defer)
	script(src='/js/site-theme.js?v=20260927-welcome-2', defer)
	script(src='/js/site-ads.js?v=20260926-2', defer)
	script(src='/js/site-notices.js?v=20260927-welcome-2', defer)

	body(style='min-width: 640px;')
		div#Top
			+Menu()
			div#global-notice
				div#gn-content
					include ../public/global_notice.html
				+Expl(L('GLOBAL_NOTICE'))
			block Top
		div#Jungle
			span#mobile= locals.mobile
			span#summonerID= DATA._id
			img#Background(src='/img/bg/' + (locals.bg || 'def.png'))
			block Jungle
		div#Middle
			block Middle
		div#Bottom
			block Bottom
			div.bottom-legal
				if locals.as_pc
					a(href='?')= L('AS_MOBILE')
				br
				a.bottom-contact(href='https://discord.gg/exfaWJDjU', target='_blank', rel='noopener noreferrer') 문의: 디스코드 서버
			div.bottom-legal!= L('GPL')
			+separator(10)
